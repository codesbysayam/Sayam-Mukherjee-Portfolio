# Environment variable names required by the application
GEMINI_API_KEY=
APP_URL=https://sayammukherjee.in

# Admin allowlist email (must match verified Firebase Google Sign-In email)
ADMIN_EMAIL=wrickbusiness@gmail.com

# Optional transactional email delivery (Resend API preferred; falls back to SMTP if configured)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=wrickbusiness@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

